{
  "schema_version": "2026-09-17-v1",
  "status": "authorized_bounded_real_image_self_distillation_pilot",
  "authorized_by_user": true,
  "authorized_at": "2026-09-17",
  "purpose": "Test stable real-image DINO class-token self-distillation after two fail-closed pilots exposed numerically identical BF16 CLS features and high-entropy teacher collapse.",
  "source": {
    "dataset": "Open Images V6 train",
    "official_description": "https://storage.googleapis.com/openimages/web/factsfigures.html",
    "image_metadata_url": "https://storage.googleapis.com/openimages/2018_04/train/train-images-boxable-with-rotation.csv",
    "image_metadata_expected_bytes": 638407721,
    "image_metadata_sha256": "05f3d68dbbb03728d1a37e51479f4f35c062b871e1a6cae8c4cefbe0e0c80ed0",
    "image_url_template": "https://open-images-dataset.s3.amazonaws.com/train/{image_id}.jpg",
    "required_image_license": "https://creativecommons.org/licenses/by/2.0/",
    "allowed_split": "train",
    "selection": "smallest sha256(seed|ImageID) among rows passing frozen metadata fields, followed by image integrity gates",
    "selection_seed": 20260917,
    "candidate_images": 28000,
    "expected_unique_images": 25000
  },
  "data_gates": {
    "metadata_size_and_sha256_exact": true,
    "selected_rows_unique": true,
    "license_exact_match": true,
    "attribution_fields_preserved": true,
    "image_sha256_recorded": true,
    "all_images_decode_rgb": true,
    "minimum_width_and_height": 224,
    "maximum_single_image_bytes": 20000000,
    "exact_pixel_file_duplicates_removed": true,
    "manifest_hash_frozen": true,
    "development_and_test_images_prohibited": true,
    "fixed_visual_audit_images": 64
  },
  "objective": {
    "name": "DINO class-token cross-view self-distillation pilot",
    "head_layers": 3,
    "head_hidden_dim": 2048,
    "bottleneck_dim": 384,
    "weight_normalized_prototypes": 8192,
    "global_views": 2,
    "local_views": 8,
    "student_temperature": 0.1,
    "teacher_temperature": 0.04,
    "teacher_assignment": "sinkhorn_knopp",
    "sinkhorn_iterations": 3,
    "teacher_center_momentum": 0.9,
    "teacher_ema_start": 0.9995,
    "teacher_ema_end": 1.0,
    "koleo_weight": 0.1,
    "koleo_input": "raw_normalized_backbone_cls_tokens",
    "precision": "fp16_compute_fp32_state_static_loss_scale",
    "loss_scale": 1024.0,
    "layer_scale_init": 0.01,
    "learning_rate": 0.0001,
    "adamw_betas": [0.9, 0.999]
  },
  "promotion_gates": {
    "all_steps_finite": true,
    "median_end_to_end_mfu_minimum": 0.5,
    "teacher_entropy_margin_below_log_prototypes": 0.05,
    "teacher_cross_sample_logit_std_minimum": 0.00001,
    "feature_nearest_neighbor_distance_minimum": 0.0001,
    "gradient_norm_minimum": 0.00001,
    "checkpoint_resume_exact_identity_required": true,
    "fixed_visual_audit_required_before_training": true
  },
  "pilot_limits": {
    "gpus": 4,
    "hardware": "RTX 4090 or RTX 5090; the exact device is recorded by each run's GPU telemetry",
    "qualification_steps": 25,
    "initial_training_steps": 250,
    "checkpoint_every_steps": 25,
    "max_wall_seconds": 7200
  },
  "claim_boundary": "This is a bounded 25,000-image research pilot. Its training objective and systems metrics do not establish downstream representation quality, full DINOv2/iBOT fidelity, corpus-scale pretraining, release readiness, or superiority over any model."
